# Copy to .env and adjust.
PORT=5050

# Leave MONGO_URI empty to use a throwaway in-memory MongoDB (auto-seeded on start).
# For a persistent database, use a local or Atlas connection string, e.g.:
# MONGO_URI=mongodb://127.0.0.1:27017/nocturne
# MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/nocturne
MONGO_URI=

# Allowed browser origin for the API in development
CLIENT_ORIGIN=http://localhost:5173
